NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<instance password>
NEO4J_DATABASE=neo4j
JWT_SECRET=<long random string>
JWT_EXPIRES_HOURS=8

# Set to 1 only behind a reverse proxy (Tailscale Funnel on elite)
TRUST_PROXY=0

# Time zone for timestamps saved by the app (Neo4j itself runs on UTC)
APP_TIMEZONE=America/Chihuahua
